{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bootstrap-sha": "252050157d0918cf57803895ae85c38a02386298",
  "packages": {
    ".": {
      "package-name": "takt",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "macos/Version.xcconfig"
        },
        {
          "type": "toml",
          "path": "libtakt/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='libtakt')].version"
        }
      ]
    }
  }
}
